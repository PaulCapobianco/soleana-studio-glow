# Copy this file to .env and fill in real values.
# Never commit .env — it is git-ignored on purpose.

# Public Supabase project URL and publishable (anon) key.
# Safe to expose client-side (VITE_ prefix): both ship to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Turnstile site key (public, client-side widget).
VITE_TURNSTILE_SITE_KEY=
